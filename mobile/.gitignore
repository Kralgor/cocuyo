# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# FCM / Firebase credential — never commit, provided via EAS file env var GOOGLE_SERVICES_JSON
google-services.json
GoogleService-Info.plist

# Firebase Admin SDK service-account key (FCM V1) — SECRET, server-side access. Never commit.
*-firebase-adminsdk-*.json
# EAS credentials (keystore refs / key material) — never commit
credentials.json
# Google Play service-account JSON for EAS Submit — SECRET, placed by human at Gate A. Never commit.
/credentials/

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android
